    ]},
    {"blend": "normal", "opacity": 1.0, "ops": [
      {"op": "pattern", "pattern": "gear",
       "params": {"color": "#F2C14E", "teeth": 24, "tooth": 0.22,
                  "spokes": 8, "hub": 0.26, "hole": 0.34}}
    ]}
